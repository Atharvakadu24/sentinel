# ==============================================================================
# Sentinel — Environment Configuration Template
# ==============================================================================
# Copy this file to .env and adjust variables for your local development setup.
# WARNING: NEVER commit .env or real credentials/keys to source control!
# Placeholders are used below; replace them with valid values for your environment.
# ==============================================================================

# ------------------------------------------------------------------------------
# Application & Server
# ------------------------------------------------------------------------------
APP_ENV=development
APP_NAME=Sentinel
API_HOST=0.0.0.0
PORT=8000
FRONTEND_ORIGIN=http://localhost:5173
LOG_LEVEL=INFO
LOG_FORMAT=json

# Secret keys for sessions and cryptographic signing (minimum 32 characters in production)
# Generate via: openssl rand -hex 32
SECRET_KEY=replace-with-a-random-32-byte-hex-string-for-dev-only
SESSION_SECRET=replace-with-a-random-32-byte-hex-string-for-session-cookies

# ------------------------------------------------------------------------------
# Database (PostgreSQL 16)
# ------------------------------------------------------------------------------
# Safe local-only development defaults matching docker-compose.yml.
# CAUTION: These default credentials are strictly for local offline development.
# In production, use strong generated passwords and managed database credentials.
DATABASE_URL=postgresql://sentinel_user:sentinel_dev_password@localhost:5432/sentinel_db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false

# ------------------------------------------------------------------------------
# Security & Fingerprinting Anchor
# ------------------------------------------------------------------------------
# Server-side key used to compute HMAC-SHA256 fingerprint anchors for detected
# secrets without storing or revealing the plaintext secret values.
# Generate via: openssl rand -hex 32
FINGERPRINT_KEY=replace-with-a-secure-random-hex-key-for-fingerprinting

# ------------------------------------------------------------------------------
# GitHub App Integration
# ------------------------------------------------------------------------------
# Required for PR webhooks, installation authentication, and PR comment reports.
# Obtain these from your GitHub App settings at https://github.com/settings/apps
GITHUB_APP_ID=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=replace-with-github-app-client-secret
GITHUB_WEBHOOK_SECRET=replace-with-github-webhook-secret
# Path to the downloaded GitHub App private key (.pem)
GITHUB_APP_PRIVATE_KEY_PATH=./secrets/github-app.private-key.pem

# ------------------------------------------------------------------------------
# AI Review Service & LLM Configuration
# ------------------------------------------------------------------------------
# Supported providers: anthropic, gemini
LLM_PROVIDER=anthropic
LLM_MODEL=claude-3-5-haiku-20241022

# API keys (placeholders only; never commit real keys)
ANTHROPIC_API_KEY=your-anthropic-api-key-placeholder
GEMINI_API_KEY=your-gemini-api-key-placeholder

# Quotas, limits, and kill-switches (Section 11)
AI_ENABLED=false
AI_DAILY_TOKEN_LIMIT_PER_USER=100000
AI_DAILY_TOKEN_CAP=500000
AI_SCAN_MAX_FILES=6
AI_SCAN_MAX_INPUT_TOKENS=40000
AI_PER_CALL_TIMEOUT_SEC=30
AI_TOTAL_BUDGET_SEC=90

# Development-only debugging flag.
# WARNING: Startup MUST fail if AI_DEBUG_LOG is true in production!
AI_DEBUG_LOG=false

# ------------------------------------------------------------------------------
# Static Analysis Scanners & Paths
# ------------------------------------------------------------------------------
# Local CLI tool paths and rules directory
SEMGREP_PATH=semgrep
GITLEAKS_PATH=gitleaks
SEMGREP_RULES_PATH=./rules/semgrep
SCANNER_TEMP_DIR=/tmp/sentinel
SEMGREP_TIMEOUT_SEC=120
GITLEAKS_TIMEOUT_SEC=60

# ------------------------------------------------------------------------------
# Background Worker & Job Queue
# ------------------------------------------------------------------------------
WORKER_POLL_INTERVAL_SEC=1.5
WORKER_JOB_LEASE_SEC=60
WORKER_HEARTBEAT_SEC=15
WORKER_MAX_CONCURRENCY=2

# ------------------------------------------------------------------------------
# Observability (Optional)
# ------------------------------------------------------------------------------
SENTRY_DSN=
